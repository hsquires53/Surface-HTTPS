// Initialize the map
const map = L.map('map', {
    crs: L.CRS.Simple,
    minZoom: -3,
    maxZoom: 2
});

// Set map bounds
const bounds = [[0, 0], [2575, 3309]];
const image = L.imageOverlay('images/Surface Map.jpg', bounds).addTo(map);
map.fitBounds(bounds);
map.setView([1200, 1600], 0);

// Add click handler for coordinate debugging
map.on('click', function(e) {
    const coord = e.latlng;
    console.log(`Clicked coordinates - Y: ${Math.round(coord.lat)}, X: ${Math.round(coord.lng)}`);
    L.popup()
        .setLatLng(e.latlng)
        .setContent(`Coordinates:<br>Y: ${Math.round(coord.lat)}<br>X: ${Math.round(coord.lng)}`)
        .openOn(map);
});

// Custom icon for Koroks
const korokIcon = L.icon({
    iconUrl: 'images/Seed.png',
    iconSize: [25, 25],
    iconAnchor: [12, 12],
    popupAnchor: [0, -12]
});

// Known exact pixel coordinates for markers
const KNOWN_POSITIONS = {
    'HR-459': { game: [-236, 632], pixel: [1420, 1604] },
    'HR-460': { game: [-269, 608], pixel: [1415, 1589] },
    'HR-465': { game: [-254, 424], pixel: [1355, 1600] },
    'NE-828': { game: [1291, -1331], pixel: [830, 2063] },
    'NE-829': { game: [1536, -1302], pixel: [840, 2135] },
    'NE-830': { game: [1626, -1360], pixel: [818, 2163] }
};

